generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Company domain ----------------------------------------------------------
// Each company owns its own ad accounts and imported files; Platform (facebook/
// shopee/tiktok) stays a shared, company-agnostic taxonomy.

model Company {
  id                    BigInt             @id @default(autoincrement())
  name                  String
  code                  String             @unique
  platforms             Json?
  facebookAdAccountId   String?            @map("facebook_ad_account_id")
  facebookAccessToken   String?            @map("facebook_access_token") @db.Text
  facebookTokenExpiresAt   DateTime?       @map("facebook_token_expires_at")
  googleAdsCustomerId   String?            @map("google_ads_customer_id")
  googleAdsRefreshToken String?            @map("google_ads_refresh_token") @db.Text
  googleAdsClientId        String?         @map("google_ads_client_id")
  googleAdsClientSecret    String?         @map("google_ads_client_secret") @db.Text
  googleAdsDeveloperToken  String?         @map("google_ads_developer_token") @db.Text
  googleAdsLoginCustomerId String?         @map("google_ads_login_customer_id")
  tiktokAdvertiserId    String?            @map("tiktok_advertiser_id")
  tiktokAccessToken     String?            @map("tiktok_access_token") @db.Text
  shopeeShopId          String?            @map("shopee_shop_id")
  shopeeAccessToken     String?            @map("shopee_access_token") @db.Text
  shopeeRefreshToken    String?            @map("shopee_refresh_token") @db.Text
  shopeeTokenExpiresAt  DateTime?          @map("shopee_token_expires_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  campaigns           Campaign[]
  importJobs          ImportJob[]
  contentImportJobs   ContentImportJob[]
  contentPosts        ContentPost[]
  adSets              AdSet[]
  ads                 Ad[]
  adPosts             AdPost[]
  adInsights          AdInsight[]
  adInsightBreakdowns AdInsightBreakdown[]
  leads               Lead[]

  @@map("companies")
}

// --- Auth domain -----------------------------------------------------------

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
}

model Platform {
  id         BigInt      @id @default(autoincrement())
  name       String
  code       String      @unique
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  campaigns           Campaign[]
  importJobs          ImportJob[]
  adSets              AdSet[]
  ads                 Ad[]
  adPosts             AdPost[]
  adInsights          AdInsight[]
  adInsightBreakdowns AdInsightBreakdown[]
  leads               Lead[]

  @@map("platforms")
}

model Campaign {
  id                 BigInt                 @id @default(autoincrement())
  companyId          BigInt                 @map("company_id")
  platformId         BigInt                 @map("platform_id")
  externalCampaignId String                 @map("external_campaign_id")
  campaignName       String                 @map("campaign_name")
  campaignStatus     String                 @map("campaign_status")
  adType             String?                @map("ad_type")
  productId          String?                @map("product_id")
  bidStrategy        String?                @map("bid_strategy")
  placement          String?
  startDate          DateTime?              @map("start_date") @db.Date
  endDate            DateTime?              @map("end_date") @db.Date
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  company            Company                @relation(fields: [companyId], references: [id])
  platform           Platform               @relation(fields: [platformId], references: [id])
  reportMetrics      CampaignReportMetric[]
  adSets             AdSet[]
  ads                Ad[]
  adInsights         AdInsight[]
  adInsightBreakdowns AdInsightBreakdown[]
  leads              Lead[]

  @@unique([companyId, platformId, externalCampaignId])
  @@map("campaigns")
}

model ImportJob {
  id              BigInt                 @id @default(autoincrement())
  companyId       BigInt                 @map("company_id")
  platformId      BigInt                 @map("platform_id")
  filename        String
  reportName      String                 @map("report_name")
  reportStartDate DateTime               @map("report_start_date") @db.Date
  reportEndDate   DateTime               @map("report_end_date") @db.Date
  totalRecords    Int                    @map("total_records")
  importedBy      BigInt?                @map("imported_by")
  status          ImportStatus
  source          ImportSource           @default(CSV)
  errorMessage    String?                @map("error_message") @db.Text
  importedAt      DateTime?              @map("imported_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  company         Company                @relation(fields: [companyId], references: [id])
  platform        Platform               @relation(fields: [platformId], references: [id])
  reportMetrics   CampaignReportMetric[]
  adInsights      AdInsight[]
  adInsightBreakdowns AdInsightBreakdown[]
  leads           Lead[]

  @@map("import_jobs")
}

model CampaignReportMetric {
  id                   BigInt    @id @default(autoincrement())
  campaignId           BigInt    @map("campaign_id")
  importJobId          BigInt    @map("import_job_id")
  reportStartDate      DateTime  @map("report_start_date") @db.Date
  reportEndDate        DateTime  @map("report_end_date") @db.Date
  impressions          Int?
  clicks               Int?
  ctr                  Decimal?  @db.Decimal(8, 4)
  addToCart            Int?      @map("add_to_cart")
  addToCartRate        Decimal?  @map("add_to_cart_rate") @db.Decimal(8, 4)
  orders               Int?
  directOrders         Int?      @map("direct_orders")
  conversionRate       Decimal?  @map("conversion_rate") @db.Decimal(8, 4)
  directConversionRate Decimal?  @map("direct_conversion_rate") @db.Decimal(8, 4)
  costPerOrder         Decimal?  @map("cost_per_order") @db.Decimal(10, 2)
  directCostPerOrder   Decimal?  @map("direct_cost_per_order") @db.Decimal(10, 2)
  unitsSold            Int?      @map("units_sold")
  directUnitsSold      Int?      @map("direct_units_sold")
  revenue              Decimal?  @db.Decimal(12, 2)
  directRevenue        Decimal?  @db.Decimal(12, 2)
  spend                Decimal?  @db.Decimal(12, 2)
  roas                 Decimal?  @db.Decimal(8, 2)
  directRoas           Decimal?  @db.Decimal(8, 2)
  acos                 Decimal?  @db.Decimal(8, 2)
  directAcos           Decimal?  @db.Decimal(8, 2)
  productImpressions   Int?      @map("product_impressions")
  productClicks        Int?      @map("product_clicks")
  productCtr           Decimal?  @map("product_ctr") @db.Decimal(8, 4)
  voucherAmount        Decimal?  @map("voucher_amount") @db.Decimal(12, 2)
  voucherSales         Decimal?  @map("voucher_sales") @db.Decimal(12, 2)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  campaign             Campaign  @relation(fields: [campaignId], references: [id])
  importJob            ImportJob @relation(fields: [importJobId], references: [id])

  @@map("campaign_report_metrics")
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportSource {
  CSV
  API
}

// --- ETL domain --------------------------------------------------------------
// API-pulled, day-granular ad hierarchy + insights + leads. Kept separate from
// Campaign/CampaignReportMetric above (which stay CSV-import-only) so nothing
// about the existing import flow changes shape. AdInsight/AdInsightBreakdown
// use a polymorphic (entityLevel, entityId) pair instead of nullable
// campaignId/adSetId/adId columns: MySQL unique indexes treat NULL != NULL, so
// a composite key with nullable columns would not stop duplicate CAMPAIGN-level
// rows from slipping in, breaking the upsert-based idempotency the daily job
// depends on.

enum InsightEntityLevel {
  CAMPAIGN
  ADSET
  AD
}

model AdSet {
  id              BigInt   @id @default(autoincrement())
  companyId       BigInt   @map("company_id")
  platformId      BigInt   @map("platform_id")
  campaignId      BigInt   @map("campaign_id")
  externalAdSetId String   @map("external_adset_id")
  name            String
  status          String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  company         Company  @relation(fields: [companyId], references: [id])
  platform        Platform @relation(fields: [platformId], references: [id])
  campaign        Campaign @relation(fields: [campaignId], references: [id])
  ads             Ad[]

  @@unique([companyId, platformId, externalAdSetId])
  @@index([campaignId])
  @@map("ad_sets")
}

model Ad {
  id           BigInt   @id @default(autoincrement())
  companyId    BigInt   @map("company_id")
  platformId   BigInt   @map("platform_id")
  campaignId   BigInt   @map("campaign_id")
  adSetId      BigInt   @map("adset_id")
  externalAdId String   @map("external_ad_id")
  name         String
  status       String
  creativeId   String?  @map("creative_id")
  postId       BigInt?  @map("post_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  company      Company  @relation(fields: [companyId], references: [id])
  platform     Platform @relation(fields: [platformId], references: [id])
  adSet        AdSet    @relation(fields: [adSetId], references: [id])
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  post         AdPost?  @relation(fields: [postId], references: [id])
  leads        Lead[]

  @@unique([companyId, platformId, externalAdId])
  @@index([adSetId])
  @@index([campaignId])
  @@index([postId])
  @@map("ads")
}

// The post an ad is boosting, resolved via ad.creative.effective_object_story_id.
// One post can back multiple ads (same post boosted by several ads/adsets), and a
// post may also never be boosted at all -- both are valid, which is the point:
// this table is how "advertised posts" get compared against organic-only ones.
model AdPost {
  id             BigInt    @id @default(autoincrement())
  companyId      BigInt    @map("company_id")
  platformId     BigInt    @map("platform_id")
  externalPostId String    @map("external_post_id")
  message        String?   @db.Text
  permalink      String?   @db.Text
  publishedAt    DateTime? @map("published_at")
  likeCount      Int?      @map("like_count")
  commentCount   Int?      @map("comment_count")
  shareCount     Int?      @map("share_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  company        Company   @relation(fields: [companyId], references: [id])
  platform       Platform  @relation(fields: [platformId], references: [id])
  ads            Ad[]

  @@unique([companyId, platformId, externalPostId])
  @@map("ad_posts")
}

model AdInsight {
  id               BigInt             @id @default(autoincrement())
  companyId        BigInt             @map("company_id")
  platformId       BigInt             @map("platform_id")
  importJobId      BigInt?            @map("import_job_id")
  entityLevel      InsightEntityLevel @map("entity_level")
  entityId         BigInt             @map("entity_id")
  campaignId       BigInt             @map("campaign_id")
  date             DateTime           @db.Date
  impressions      Int?
  clicks           Int?
  spend            Decimal?           @db.Decimal(12, 2)
  reach            Int?
  frequency        Decimal?           @db.Decimal(8, 4)
  ctr              Decimal?           @db.Decimal(8, 4)
  cpc              Decimal?           @db.Decimal(10, 4)
  cpm              Decimal?           @db.Decimal(10, 4)
  conversions      Decimal?           @db.Decimal(12, 2)
  conversionsValue Decimal?           @map("conversions_value") @db.Decimal(12, 2)
  raw              Json?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  company          Company            @relation(fields: [companyId], references: [id])
  platform         Platform           @relation(fields: [platformId], references: [id])
  campaign         Campaign           @relation(fields: [campaignId], references: [id])
  importJob        ImportJob?         @relation(fields: [importJobId], references: [id])

  @@unique([companyId, platformId, entityLevel, entityId, date])
  @@index([campaignId, date])
  @@index([companyId, platformId, date])
  @@map("ad_insights")
}

model AdInsightBreakdown {
  id               BigInt             @id @default(autoincrement())
  companyId        BigInt             @map("company_id")
  platformId       BigInt             @map("platform_id")
  importJobId      BigInt?            @map("import_job_id")
  entityLevel      InsightEntityLevel @map("entity_level")
  entityId         BigInt             @map("entity_id")
  campaignId       BigInt             @map("campaign_id")
  date             DateTime           @db.Date
  dimensionType    String             @map("dimension_type")
  dimensionValue   String             @map("dimension_value")
  impressions      Int?
  clicks           Int?
  spend            Decimal?           @db.Decimal(12, 2)
  reach            Int?
  conversions      Decimal?           @db.Decimal(12, 2)
  conversionsValue Decimal?           @map("conversions_value") @db.Decimal(12, 2)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  company          Company            @relation(fields: [companyId], references: [id])
  platform         Platform           @relation(fields: [platformId], references: [id])
  campaign         Campaign           @relation(fields: [campaignId], references: [id])
  importJob        ImportJob?         @relation(fields: [importJobId], references: [id])

  @@unique([companyId, platformId, entityLevel, entityId, date, dimensionType, dimensionValue])
  @@index([campaignId, date, dimensionType])
  @@map("ad_insight_breakdowns")
}

model Lead {
  id                BigInt     @id @default(autoincrement())
  companyId         BigInt     @map("company_id")
  platformId        BigInt     @map("platform_id")
  campaignId        BigInt?    @map("campaign_id")
  adId              BigInt?    @map("ad_id")
  importJobId       BigInt?    @map("import_job_id")
  source            String
  externalLeadId    String     @map("external_lead_id")
  formId            String?    @map("form_id")
  fullName          String?    @map("full_name") @db.Text
  email             String?    @db.Text
  phone             String?    @db.Text
  status            String?
  createdAtExternal DateTime?  @map("created_at_external")
  raw               Json?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  company           Company    @relation(fields: [companyId], references: [id])
  platform          Platform   @relation(fields: [platformId], references: [id])
  campaign          Campaign?  @relation(fields: [campaignId], references: [id])
  ad                Ad?        @relation(fields: [adId], references: [id])
  importJob         ImportJob? @relation(fields: [importJobId], references: [id])

  @@unique([companyId, platformId, externalLeadId])
  @@index([companyId, campaignId])
  @@index([createdAtExternal])
  @@map("leads")
}

// --- Content (organic posts) domain ---------------------------------------
// Separate from Platform/Campaign/CampaignReportMetric above, which model
// periodic AD CAMPAIGN reports (spend/revenue per date range, additive across
// imports). Content posts are CUMULATIVE LIFETIME snapshots per post -- every
// export re-states each post's all-time totals, so re-importing must
// overwrite (upsert) a post's single metric row, never sum across imports.

model ContentPlatform {
  id         BigInt             @id @default(autoincrement())
  code       String             @unique // "FACEBOOK" (future: "TIKTOK", "INSTAGRAM")
  name       String
  isActive   Boolean            @default(true) @map("is_active")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  posts      ContentPost[]
  importJobs ContentImportJob[]

  @@map("content_platforms")
}

model ContentImportJob {
  id             BigInt          @id @default(autoincrement())
  companyId      BigInt          @map("company_id")
  platformId     BigInt          @map("platform_id")
  filename       String
  rangeStartDate DateTime?       @map("range_start_date") @db.Date
  rangeEndDate   DateTime?       @map("range_end_date") @db.Date
  totalRecords   Int             @map("total_records")
  status         ImportStatus
  errorMessage   String?         @map("error_message") @db.Text
  importedAt     DateTime?       @map("imported_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  company        Company         @relation(fields: [companyId], references: [id])
  platform       ContentPlatform @relation(fields: [platformId], references: [id])
  posts          ContentPost[]

  @@map("content_import_jobs")
}

model ContentPost {
  id              BigInt             @id @default(autoincrement())
  companyId       BigInt             @map("company_id")
  platformId      BigInt             @map("platform_id")
  externalPostId  String             @map("external_post_id")
  pageExternalId  String?            @map("page_external_id")
  pageName        String?            @map("page_name")
  title           String?            @db.Text
  postType        String?            @map("post_type")
  permalink       String?            @db.Text
  imageUrl        String?            @map("image_url") @db.Text
  publishedAt     DateTime?          @map("published_at")
  durationSeconds Int?               @map("duration_seconds")
  lastImportJobId BigInt?            @map("last_import_job_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  company         Company            @relation(fields: [companyId], references: [id])
  platform        ContentPlatform    @relation(fields: [platformId], references: [id])
  lastImportJob   ContentImportJob?  @relation(fields: [lastImportJobId], references: [id])
  metric          ContentPostMetric?

  @@unique([companyId, platformId, externalPostId])
  @@map("content_posts")
}

model ContentPostMetric {
  id               BigInt      @id @default(autoincrement())
  postId           BigInt      @unique @map("post_id")
  avgSecondsViewed Decimal?    @map("avg_seconds_viewed") @db.Decimal(10, 3)
  reach            Int?
  impressions      Int?
  reactions        Int?
  comments         Int?
  shares           Int?
  saves            Int?
  newFollowers     Int?        @map("new_followers")
  viewers          Int?
  views            Int?
  updatedAt        DateTime    @updatedAt @map("updated_at")
  post             ContentPost @relation(fields: [postId], references: [id])

  @@map("content_post_metrics")
}
